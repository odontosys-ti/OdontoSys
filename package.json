{
  "name": "odontosys",
  "version": "0.1.0",
  "description": "Sistema de gestão para pequenas clínicas odontológicas",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r --filter=./packages --filter=./apps build",
    "lint": "eslint . --ext .ts,.tsx --max-warnings=0 && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "db:migrate": "pnpm --filter=@odontosys/api run db:migrate",
    "db:generate": "pnpm --filter=@odontosys/api run db:generate",
    "db:seed": "pnpm --filter=@odontosys/api run db:seed",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "odontologia",
    "gestão",
    "clínica",
    "agendamento"
  ],
  "author": "OdontoSys Team",
  "license": "MIT",
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-import": "^2.29.0",
    "prettier": "^3.2.0",
    "typescript": "^5.5.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  }
}
