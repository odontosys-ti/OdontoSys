{
  "name": "@odontosys/web",
  "version": "0.1.0",
  "description": "Interface web do OdontoSys",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint src tests --ext .ts,.tsx --max-warnings=0 && prettier --check src tests",
    "format": "prettier --write src tests",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit"
  },
  "keywords": ["web", "react", "vite", "odontologia"],
  "author": "OdontoSys Team",
  "license": "MIT",
  "dependencies": {
    "@odontosys/contracts": "workspace:*",
    "@tanstack/react-query": "^5.51.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.5.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
